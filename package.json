{
  "name": "asvc",
  "version": "0.1.0",
  "description": "统一管理本地开发服务的守护进程 + CLI，让人和 agent 通过同一套 asvc 命令启动/重启/关闭服务，避免端口冲突与重复启动。",
  "type": "module",
  "license": "MIT",
  "author": "homeant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeant/agent-server-manager.git"
  },
  "keywords": [
    "dev-server",
    "process-manager",
    "daemon",
    "cli",
    "agent",
    "claude-code"
  ],
  "bin": {
    "asvc": "dist/cli.js",
    "asvc-daemon": "dist/daemon/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
