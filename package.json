{
  "name": "dev-server-manager",
  "version": "0.1.0",
  "description": "统一管理本地开发服务的守护进程 + CLI，让人和 agent 通过同一套 svc 命令启动/重启/关闭服务，避免端口冲突与重复启动。",
  "type": "module",
  "bin": {
    "svc": "dist/cli.js",
    "svc-daemon": "dist/daemon/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
