{
  "name": "@homeant/asvc",
  "version": "0.4.0",
  "description": "统一管理本地开发服务的守护进程 + CLI，让人和 agent 通过同一套 asvc 命令启动/重启/关闭服务，避免端口冲突与重复启动。",
  "type": "module",
  "license": "MIT",
  "author": "homeant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeant/agent-server-manager.git"
  },
  "keywords": [
    "dev-server",
    "process-manager",
    "daemon",
    "cli",
    "agent",
    "claude-code"
  ],
  "bin": {
    "asvc": "npm/bin/asvc.js"
  },
  "files": [
    "npm/bin/asvc.js",
    "skill"
  ],
  "scripts": {
    "build": "cargo build --release",
    "package:native": "node scripts/package-platform.mjs",
    "build:mac": "sh scripts/build-macos.sh",
    "build:standalone:mac": "npm run build:mac",
    "test": "cargo test --locked",
    "test:native": "node scripts/test-npm-launcher.mjs && node scripts/test-npm-install.mjs",
    "test:standalone:mac": "npm run build:mac && npm run test:native",
    "prepack": "node scripts/verify-npm-packages.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@homeant/asvc-darwin-arm64": "0.4.0",
    "@homeant/asvc-darwin-x64": "0.4.0",
    "@homeant/asvc-linux-arm64": "0.4.0",
    "@homeant/asvc-linux-x64": "0.4.0",
    "@homeant/asvc-win32-x64": "0.4.0"
  }
}
