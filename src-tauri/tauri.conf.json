{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asvc",
  "version": "0.4.7",
  "identifier": "com.homeant.asvc",
  "build": {
    "beforeDevCommand": "npm --prefix desktop run dev",
    "beforeBuildCommand": "npm --prefix desktop run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Asvc · Local Services",
        "width": 1320,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/asvc"],
    "targets": "all",
    "icon": [
      "icons/asvc/app-32.png",
      "icons/asvc/app-64.png",
      "icons/asvc/app-128.png",
      "icons/asvc/app-128@2x.png",
      "icons/asvc/app.icns",
      "icons/asvc/app.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQ0ExOEU5ODUzODk3NTQKUldSVWx6aUY2UmpLdXhCOFdmNHR2QnNkeXhkM1ZXNW4vYzU2bEltRnB5WjlTdnRTK0RCV01CY2cK",
      "endpoints": [
        "https://github.com/homeant/agent-server-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
